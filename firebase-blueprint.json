{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "profilePic": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name", "role", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A booking made by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "format": "email" },
        "customerName": { "type": "string" },
        "route": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "seats": { "type": "number" },
        "seatNumbers": { "type": "array", "items": { "type": "number" } },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["Confirmed", "Pending", "Completed"] },
        "pickup": { "type": "string" },
        "dropoff": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "customerName", "route", "date", "time", "seats", "totalPrice", "status"]
    },
    "Destination": {
      "title": "Destination",
      "description": "A travel destination",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string", "enum": ["Culture", "Nature", "Nightlife", "Beach"] }
      },
      "required": ["name", "lat", "lng", "imageUrl", "category"]
    },
    "Banners": {
      "title": "Banners",
      "description": "Banner settings",
      "type": "object",
      "properties": {
        "banners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "url": { "type": "string" },
              "type": { "type": "string", "enum": ["video", "image"] }
            },
            "required": ["id", "url", "type"]
          }
        }
      },
      "required": ["banners"]
    },
    "QRIS": {
      "title": "QRIS",
      "description": "QRIS settings",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string" }
      },
      "required": ["imageUrl"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "User bookings"
    },
    "destinations/{destinationId}": {
      "schema": { "$ref": "#/entities/Destination" },
      "description": "Travel destinations"
    },
    "settings/banners": {
      "schema": { "$ref": "#/entities/Banners" },
      "description": "Banner settings"
    },
    "settings/qris": {
      "schema": { "$ref": "#/entities/QRIS" },
      "description": "QRIS settings"
    }
  }
}
